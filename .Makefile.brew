##@ Packages
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_FORCE_BREWED_CURL=1
export PATH:=/usr/local/bin:/opt/homebrew/bin:$(PATH)

BREW_PREFIX:=$(shell brew --prefix 2> /dev/null)
# brew is not on PATH yet on a fresh machine so fallback to arch default
ifeq "$(BREW_PREFIX)" ""
ifeq "$(shell uname -m)" "arm64"
BREW_PREFIX=/opt/homebrew
else
BREW_PREFIX=/usr/local
endif
endif
BREW=$(BREW_PREFIX)/bin/brew

OS=$(shell uname)

update:: update/brew

update/brew::
	@

upgrade:: upgrade/brew

upgrade/brew::
	@

ifeq "$(OS)" "Darwin"
update/brew::
	brew update

upgrade/brew:: $(BREW)
	brew upgrade
	brew cleanup

tidy:: tidy/brew

tidy/brew::
	@

ifeq "$(OS)" "Darwin"
tidy/brew::
	brew cleanup
endif

brew/%: ## install brew formula
## taps are set per target, e.g. brew/dyff: TAP=homeport/tap/
brew/%: $(BREW_PREFIX)/Cellar/%
	@

cask/%: ## install brew cask
cask/%: $(BREW_PREFIX)/Caskroom/%
	@

$(BREW_PREFIX)/Cellar/%: | $(BREW)
	brew install $(TAP)$* $(BREW_OPTIONS)

$(BREW_PREFIX)/Caskroom/%: | $(BREW)
	brew install --cask $(TAP)$* $(BREW_OPTIONS)

$(BREW):
	/bin/bash -c "$$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

else
brew/%:
	@
cask/%:
	@
endif
