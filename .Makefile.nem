##@ Packages
NIMBLE_PREFIX=$(HOME)/.nimble
PATH:=$(NIMBLE_PREFIX)/bin:$(PATH)

upgrade:: upgrade/nimble

upgrade/nimble::
	@

ifneq "$(shell which nimble 2> /dev/null)" ""
upgrade/nimble::
	nimble upgrade
endif

nimble/%: ## install nim package with nimble
nimble/%: $(NIMBLE_PREFIX)/bin/%
	@

# TODO use choosenim
$(NIMBLE_PREFIX)/bin/%:
	nimble install -y $*
