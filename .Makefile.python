##@ Packages
MISE_PYPI_STAMPS=$(MISE_DATA_DIR)/.pypi

# $(call mise_pypi_install,<tool>[,<new with dep>]) - (re)install tool with all its with deps
# -f as mise does not reinstall when only "with" deps change
# with deps are read via $(shell) as $(wildcard) caches dirs before stamps are created
mise_pypi_with = $(patsubst %,"%",$(sort $2 $(shell ls $(MISE_PYPI_STAMPS)/with/$1 2> /dev/null)))
mise_pypi_install = mise use -g -f \
	$(if $(call mise_pypi_with,$1,$2),--tool-option 'with=[$(subst $(SPACE),$(COMMA),$(call mise_pypi_with,$1,$2))]') \
	'pypi:$(firstword $(NAME) $1)$(if $(VERSION),@$(VERSION))'

# legacy python tool managers - python tools are now managed by mise, see pypi/%
tidy:: tidy/pipx tidy/uv

# pipx home moved to platform dirs in pipx 1.3 unless ~/.local/pipx existed
tidy/pipx::  ## remove legacy pipx tools
	$(call tidy_dir,$(HOME)/.local/pipx)
	$(call tidy_dir,$(HOME)/.local/share/pipx)
	$(call tidy_dir,$(HOME)/Library/Application Support/pipx)

tidy/uv::  ## remove legacy uv tools
	$(call tidy_dir,$(HOME)/.local/share/uv/tools)

##@ Packages

python/%: ## install python version with mise
python/%: $(MISE_DATA_DIR)/installs/python/%
	@

$(MISE_DATA_DIR)/installs/python/%: | brew/mise pacman/mise
	mise install python@$*

# with rules must be before tool ones as make 3.81 uses first matching pattern rule
pypi/with/%: ## inject dep into pypi tool venv
## e.g. pypi/poetry: pypi/with/poetry/poetry-plugin-export
pypi/with/%: $(MISE_PYPI_STAMPS)/with/%
	@

pypi/%: ## install python cli via mise (uv backend)
## pin with VERSION, e.g. make pypi/poetry VERSION=2.1.0
pypi/%: $(MISE_PYPI_STAMPS)/%
	@

# tool stamp is built before its with deps so each new with dep reinstalls the tool
$(MISE_PYPI_STAMPS)/with/%: | brew/mise pacman/mise brew/uv pacman/uv
	$(call mise_pypi_install,$(firstword $(subst /, ,$*)),$(notdir $*))
	@mkdir -p $(@D) && touch $@

$(MISE_PYPI_STAMPS)/%: | brew/mise pacman/mise brew/uv pacman/uv
	$(call mise_pypi_install,$*)
	@mkdir -p $(@D) && touch $@
