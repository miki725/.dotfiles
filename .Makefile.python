##@ Packages
UV_TOOLS=$(HOME)/.local/share/uv/tools
UV_PYTHON_DIR=$(HOME)/.local/share/uv/python

ifeq "$(OS)" "Linux"
UV_PYTHON_LIBC=$(shell ldd /usr/bin/env 2>&1 | grep -qF musl && echo musl || echo gnu)
UV_PYTHON_PLATFORM=linux-$(shell uname -m)-$(UV_PYTHON_LIBC)
else ifeq "$(OS)" "Darwin"
UV_PYTHON_PLATFORM=macos-$(subst arm64,aarch64,$(shell uname -m))-none
endif

##@ Maintenance
uv-tools-clean:  ## remove all installed uv tools
	-rm -rf $(UV_TOOLS)

##@ Packages

upgrade:: upgrade/uv

upgrade/uv::
	@

ifneq "$(shell which uv 2> /dev/null)" ""
upgrade/uv::
	uv tool upgrade --all
endif

uv/python/%: ## install python version with uv
uv/python/%: $(UV_PYTHON_DIR)/cpython-%-$(UV_PYTHON_PLATFORM)
	@

uv/inject/%: ## inject dep into uv tool venv
## e.g. make uv/inject/poetry/poetry-plugin-export
uv/inject/%: $(UV_TOOLS)/%.inject
	@

uv/%: ## install python cli as uv tool
## pin with VERSION, e.g. make uv/poetry VERSION===2.1.0
uv/%: $(UV_TOOLS)/%/bin
	@

.SECONDEXPANSION:
# reinstall with all previously injected deps (existing *.inject files) plus the new one ($@)
$(UV_TOOLS)/%.inject: $$(dir $$@)bin
	uv tool install \
		$(foreach f,$(wildcard $(dir $@)*.inject) $@,--with $(basename $(notdir $f))) \
		$(firstword $(subst /, ,$*))
	touch $@

$(UV_TOOLS)/%/bin: | brew/uv pacman/uv
	uv tool install '$(firstword $(NAME) $*)$(VERSION)' $(UV_TOOL_OPTIONS)

$(UV_PYTHON_DIR)/cpython-%-$(UV_PYTHON_PLATFORM): | brew/uv pacman/uv
	uv python install $*
