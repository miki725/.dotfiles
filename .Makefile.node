##@ Packages
MISE_DATA_DIR=$(HOME)/.local/share/mise
MISE_NPM_STAMPS=$(MISE_DATA_DIR)/.npm
MISE_NODE=$(MISE_DATA_DIR)/installs/node
MISE_NODE_VERSION?=lts

upgrade:: upgrade/mise

upgrade/mise::
	@

ifneq "$(shell which mise)" ""
upgrade/mise::
	mise upgrade
endif

tidy:: tidy/mise

tidy/mise::
	@

ifneq "$(shell which mise)" ""
tidy/mise::
	mise prune
endif

mise/node/%: ## install node version with mise
mise/node/%: $(MISE_DATA_DIR)/installs/node/%
	@

$(MISE_DATA_DIR)/installs/node/%: | brew/mise pacman/mise
	mise use -g node@$*

mise/npm/%: ## install npm package via mise
mise/npm/%: $(MISE_NPM_STAMPS)/%
	@

# npm packages need some node version - install default one if there is none
$(MISE_NODE): | brew/mise pacman/mise
	mise use -g node@$(MISE_NODE_VERSION)

$(MISE_NPM_STAMPS)/%: | brew/mise pacman/mise $(MISE_NODE)
	mise use -g 'npm:$*'
	@mkdir -p $(@D) && touch $@
